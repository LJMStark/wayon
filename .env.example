# Copy to .env.local and fill in values. DO NOT commit .env.local.

# Payload CMS
PAYLOAD_SECRET=
DATABASE_URL=

# Cloudflare R2 media storage
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_ENDPOINT=
R2_PUBLIC_URL=
NEXT_PUBLIC_R2_PUBLIC_URL=

# Public deployment origin
NEXT_PUBLIC_SITE_URL=https://www.zylsinteredstone.com

# AI product copy generation (server-side script only)
OPENAI_API_KEY=
OPENAI_PRODUCT_COPY_MODEL=gpt-5.4-mini

# GLM (智谱 AI) — admin "Translate from Chinese" feature
# Required when operators trigger the in-admin translation button
GLM_API_KEY=
GLM_BASE_URL=https://open.bigmodel.cn/api/paas/v4
GLM_MODEL=glm-4-flash

# Resend — inquiry email notifications
RESEND_API_KEY=
RESEND_FROM_EMAIL=
INQUIRY_NOTIFY_TO=

# Analytics (all optional; scripts are gated on presence)
NEXT_PUBLIC_GA_MEASUREMENT_ID=
NEXT_PUBLIC_BAIDU_TONGJI_ID=
